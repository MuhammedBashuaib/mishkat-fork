<?xml version="1.0" encoding="utf-8"?>
<!-- Runs in the launcher, without waking Flutter or scheduling per-second work. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mishkat_prayer_countdown"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:countDown="true"
    android:fontFamily="monospace"
    android:gravity="center"
    android:includeFontPadding="false"
    android:layoutDirection="ltr"
    android:maxLines="1"
    android:textDirection="ltr"
    android:textColor="@color/mishkat_widget_countdown_text"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="16sp"
    android:autoSizeMaxTextSize="22sp"
    android:autoSizeStepGranularity="1sp"
    android:textSize="22sp"
    android:textStyle="bold" />
